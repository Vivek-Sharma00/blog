---
import { createSupabaseServerClient } from '../lib/supabase';

const supabase = createSupabaseServerClient(Astro.cookies);
const { data: { user } } = await supabase.auth.getUser();

let userRole: string | null = null;
if (user) {
  const { data: profile } = await supabase
    .from('profiles')
    .select('role')
    .eq('id', user.id)
    .single();
  userRole = profile?.role ?? 'reader';
}

const currentPath = Astro.url.pathname;
const isActive = (path: string) => currentPath === path || currentPath.startsWith(path + '/');
---

<header class="sticky top-0 z-50 w-full glass border-b border-slate-200/60 dark:border-slate-700/60">
  <nav class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between gap-4" aria-label="Main navigation">
    <!-- Logo -->
    <a href="/" class="flex items-center gap-2.5 group flex-shrink-0">
      <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-brand-500 to-sky-600 flex items-center justify-center shadow-sm group-hover:shadow-brand-500/40 transition-shadow">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/>
        </svg>
      </div>
      <span class="font-bold text-lg tracking-tight text-slate-900 dark:text-slate-100">
        SoloDev<span class="text-brand-500">.</span>Blog
      </span>
    </a>

    <!-- Nav links (desktop) -->
    <div class="hidden sm:flex items-center gap-1">
      <a
        href="/"
        class:list={[
          'btn-ghost text-sm px-3 py-1.5 rounded-lg',
          isActive('/') && currentPath === '/' ? 'bg-slate-100 dark:bg-slate-800 text-slate-900 dark:text-slate-100 font-medium' : ''
        ]}
      >
        Articles
      </a>
    </div>

    <!-- Actions -->
    <div class="flex items-center gap-2">
      <!-- Dark mode toggle -->
      <button
        id="theme-toggle"
        class="btn-ghost p-2 rounded-lg"
        aria-label="Toggle dark mode"
        title="Toggle dark mode"
      >
        <svg id="sun-icon" class="hidden dark:block w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
        </svg>
        <svg id="moon-icon" class="block dark:hidden w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
        </svg>
      </button>

      {userRole === 'admin' && (
        <a href="/admin/new" class="btn-primary text-sm hidden sm:inline-flex">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
          </svg>
          New Post
        </a>
      )}

      {user ? (
        <div class="flex items-center gap-2">
          <div class="hidden sm:flex items-center gap-2 px-3 py-1.5 rounded-lg bg-slate-100 dark:bg-slate-800">
            <div class="w-6 h-6 rounded-full bg-gradient-to-br from-brand-400 to-sky-500 flex items-center justify-center text-xs font-bold text-white flex-shrink-0">
              {user.email?.[0]?.toUpperCase() ?? 'U'}
            </div>
            <span class="text-sm text-slate-700 dark:text-slate-300 max-w-[140px] truncate">
              {user.email}
            </span>
          </div>
          <a href="/api/auth/signout" class="btn-ghost text-sm text-red-600 dark:text-red-400 hover:bg-red-50 dark:hover:bg-red-900/20 px-3 py-1.5">
            Sign Out
          </a>
        </div>
      ) : (
        <a href="/login" class="btn-primary text-sm">
          Sign In
        </a>
      )}
    </div>
  </nav>
</header>

<script>
  const toggle = document.getElementById('theme-toggle');
  toggle?.addEventListener('click', () => {
    const html = document.documentElement;
    html.classList.toggle('dark');
    localStorage.setItem('theme', html.classList.contains('dark') ? 'dark' : 'light');
  });
</script>
