---
// Navbar.astro — polished floating header
import ThemeToggle from './ThemeToggle.astro';
---

<header class="sticky top-0 z-50 w-full border-b border-neutral-200/60 dark:border-neutral-800/60 bg-white/80 dark:bg-neutral-950/80 backdrop-blur-md">
  <nav class="max-w-[1600px] mx-auto px-6 h-14 flex items-center justify-between">

    <!-- Brand -->
    <a
      href="/"
      class="flex items-center gap-2 no-underline group"
      aria-label="SoloDev — Home"
    >
      <!-- Logo mark -->
      <div class="w-7 h-7 rounded-lg bg-gradient-to-br from-indigo-500 to-violet-600 flex items-center justify-center shadow-sm group-hover:shadow-indigo-500/30 group-hover:scale-105 transition-all duration-200">
        <span class="text-white font-black text-sm leading-none select-none">S</span>
      </div>
      <span class="font-semibold text-neutral-900 dark:text-neutral-100 tracking-tight group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors duration-150">
        SoloDev
      </span>
    </a>

    <!-- Right side -->
    <div class="flex items-center gap-3">
      <a
        href="/"
        class="hidden sm:inline-flex text-sm text-neutral-500 dark:text-neutral-400 hover:text-neutral-800 dark:hover:text-neutral-200 transition-colors duration-150 no-underline font-medium"
      >
        Articles
      </a>
      <div class="h-4 w-px bg-neutral-200 dark:bg-neutral-700 hidden sm:block"></div>
      <ThemeToggle />
    </div>
  </nav>
</header>
