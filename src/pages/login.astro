---
import Layout from '../layouts/Layout.astro';
import { createSupabaseServerClient } from '../lib/supabase';

// If already logged in, redirect home
const supabase = createSupabaseServerClient(Astro.cookies);
const { data: { user } } = await supabase.auth.getUser();
if (user) return Astro.redirect('/');

const error = Astro.url.searchParams.get('error');
const message = Astro.url.searchParams.get('message');
---

<Layout title="Sign In · SoloDev Blog" description="Sign in to SoloDev Blog to like posts and join the conversation.">
  <div class="min-h-dvh flex flex-col items-center justify-center px-4 relative overflow-hidden">
    <!-- Background -->
    <div class="absolute inset-0 -z-10 bg-gradient-to-br from-slate-50 via-brand-50/30 to-sky-50/40 dark:from-gray-950 dark:via-brand-950/20 dark:to-gray-950"></div>
    <!-- Orbs -->
    <div class="absolute top-1/4 left-1/4 w-64 h-64 bg-brand-400/10 dark:bg-brand-500/5 rounded-full blur-3xl -z-10 animate-pulse"></div>
    <div class="absolute bottom-1/4 right-1/4 w-80 h-80 bg-sky-400/10 dark:bg-sky-500/5 rounded-full blur-3xl -z-10 animate-pulse" style="animation-delay: 1s;"></div>

    <!-- Logo -->
    <a href="/" class="flex items-center gap-2.5 mb-8 group">
      <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-brand-500 to-sky-600 flex items-center justify-center shadow-sm">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/>
        </svg>
      </div>
      <span class="font-bold text-xl tracking-tight text-slate-900 dark:text-slate-100">
        SoloDev<span class="text-brand-500">.</span>Blog
      </span>
    </a>

    <!-- Card -->
    <div class="w-full max-w-sm card p-8 animate-slide-up">
      <div class="text-center mb-8">
        <h1 class="text-2xl font-bold text-slate-900 dark:text-slate-100 mb-1.5">Welcome back</h1>
        <p class="text-sm text-slate-500 dark:text-slate-400">Sign in to like posts and leave comments</p>
      </div>

      <!-- Error / Message alerts -->
      {error && (
        <div class="mb-4 p-3 rounded-lg bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 text-red-700 dark:text-red-400 text-sm flex items-center gap-2">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="flex-shrink-0">
            <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
          </svg>
          {decodeURIComponent(error)}
        </div>
      )}
      {message && (
        <div class="mb-4 p-3 rounded-lg bg-green-50 dark:bg-green-900/20 border border-green-200 dark:border-green-800 text-green-700 dark:text-green-400 text-sm flex items-center gap-2">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="flex-shrink-0">
            <polyline points="20 6 9 17 4 12"/>
          </svg>
          {decodeURIComponent(message)}
        </div>
      )}

      <!-- Magic Link form -->
      <form id="magic-link-form" class="space-y-4" novalidate>
        <div>
          <label for="email" class="label">Email address</label>
          <input
            type="email"
            id="email"
            name="email"
            class="input"
            placeholder="you@example.com"
            autocomplete="email"
            required
          />
        </div>
        <button type="submit" id="magic-link-btn" class="btn-primary w-full justify-center py-2.5">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/>
          </svg>
          Send Magic Link
        </button>
      </form>

      <!-- Divider -->
      <div class="my-6 flex items-center gap-3">
        <div class="flex-1 h-px bg-slate-200 dark:bg-slate-700"></div>
        <span class="text-xs text-slate-400 dark:text-slate-500 uppercase tracking-widest">or</span>
        <div class="flex-1 h-px bg-slate-200 dark:bg-slate-700"></div>
      </div>

      <!-- Google OAuth (placeholder) -->
      <button
        id="google-btn"
        class="btn-secondary w-full justify-center py-2.5 gap-2.5"
        type="button"
      >
        <svg width="18" height="18" viewBox="0 0 24 24">
          <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
          <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
          <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
          <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
        </svg>
        Continue with Google
      </button>

      <p class="mt-6 text-center text-xs text-slate-400 dark:text-slate-500">
        By signing in, you agree to our terms of service.
      </p>
    </div>

    <!-- Back link -->
    <a href="/" class="mt-6 text-sm text-slate-500 dark:text-slate-400 hover:text-brand-600 dark:hover:text-brand-400 transition-colors">
      ← Back to articles
    </a>
  </div>
</Layout>

<script>
  const form = document.getElementById('magic-link-form') as HTMLFormElement;
  const btn = document.getElementById('magic-link-btn') as HTMLButtonElement;
  const googleBtn = document.getElementById('google-btn') as HTMLButtonElement;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const email = (document.getElementById('email') as HTMLInputElement).value.trim();
    if (!email) return;

    btn.disabled = true;
    btn.textContent = 'Sending…';

    try {
      const res = await fetch('/api/auth/magic-link', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email }),
      });
      const json = await res.json();
      if (res.ok) {
        window.location.href = '/login?message=' + encodeURIComponent('Check your email for the magic link!');
      } else {
        window.location.href = '/login?error=' + encodeURIComponent(json.error ?? 'Failed to send link.');
      }
    } catch {
      window.location.href = '/login?error=' + encodeURIComponent('Network error. Please try again.');
    }
  });

  googleBtn?.addEventListener('click', async () => {
    googleBtn.disabled = true;
    googleBtn.textContent = 'Redirecting…';
    try {
      const res = await fetch('/api/auth/google', { method: 'POST' });
      const json = await res.json();
      if (json.url) {
        window.location.href = json.url;
      } else {
        alert(json.error ?? 'Google sign-in unavailable.');
        googleBtn.disabled = false;
        googleBtn.textContent = 'Continue with Google';
      }
    } catch {
      alert('Network error.');
      googleBtn.disabled = false;
    }
  });
</script>
