---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import { createSupabaseServerClient } from '../../lib/supabase';
import { readingTime, formatDate } from '../../lib/utils';
import { marked } from 'marked';

const { slug } = Astro.params;
if (!slug) return Astro.redirect('/');

const supabase = createSupabaseServerClient(Astro.cookies);

// Get post
const { data: post, error } = await supabase
  .from('posts')
  .select('*')
  .eq('slug', slug)
  .eq('published', true)
  .single();

if (error || !post) {
  return Astro.redirect('/');
}

// Get author profile
const { data: author } = await supabase
  .from('profiles')
  .select('email, role')
  .eq('id', post.author_id)
  .single();

// Get current user
const { data: { user } } = await supabase.auth.getUser();

// Get comments (with commenter email via profiles)
const { data: rawComments } = await supabase
  .from('comments')
  .select('id, content, created_at, user_id, profiles(email)')
  .eq('post_id', post.id)
  .order('created_at', { ascending: true });

const comments = (rawComments ?? []).map((c: any) => ({
  ...c,
  author_email: c.profiles?.email ?? 'Anonymous',
}));

// Get likes count
const { count: likesCount } = await supabase
  .from('likes')
  .select('*', { count: 'exact', head: true })
  .eq('post_id', post.id);

// Check if current user liked
let userLiked = false;
if (user) {
  const { data: like } = await supabase
    .from('likes')
    .select('id')
    .eq('post_id', post.id)
    .eq('user_id', user.id)
    .single();
  userLiked = !!like;
}

// Render markdown to HTML
marked.setOptions({ gfm: true, breaks: true });
const contentHtml = marked(post.content);
const rt = readingTime(post.content);
const formattedDate = formatDate(post.created_at);
---

<Layout title={post.title} description={post.summary}>
  <Navbar />

  <main class="flex-1">
    <!-- Article Header -->
    <div class="relative overflow-hidden border-b border-slate-200 dark:border-slate-800">
      <div class="absolute inset-0 -z-10 bg-gradient-to-b from-brand-50/50 dark:from-brand-950/20 to-transparent"></div>
      <div class="max-w-3xl mx-auto px-4 sm:px-6 py-12 sm:py-16 animate-fade-in">
        <div class="flex items-center gap-2 mb-4">
          <a href="/" class="badge-blue hover:bg-brand-200 dark:hover:bg-brand-800/60 transition-colors text-xs">
            ← All Articles
          </a>
        </div>
        <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-slate-900 dark:text-white leading-tight mb-4">
          {post.title}
        </h1>
        <p class="text-lg text-slate-600 dark:text-slate-400 mb-6 leading-relaxed">
          {post.summary}
        </p>
        <!-- Meta bar -->
        <div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-slate-500 dark:text-slate-400">
          <div class="flex items-center gap-2">
            <div class="w-7 h-7 rounded-full bg-gradient-to-br from-brand-400 to-sky-500 flex items-center justify-center text-xs font-bold text-white">
              {author?.email?.[0]?.toUpperCase() ?? 'A'}
            </div>
            <span>{author?.email ?? 'Anonymous'}</span>
          </div>
          <span class="text-slate-300 dark:text-slate-700">·</span>
          <time datetime={post.created_at}>{formattedDate}</time>
          <span class="text-slate-300 dark:text-slate-700">·</span>
          <span class="flex items-center gap-1">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
            </svg>
            {rt}
          </span>
          <!-- Like count display in header -->
          <span class="flex items-center gap-1">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
            </svg>
            <span id="header-likes">{likesCount ?? 0}</span> likes
          </span>
        </div>
      </div>
    </div>

    <!-- Article Body -->
    <div class="max-w-3xl mx-auto px-4 sm:px-6 py-10 animate-slide-up">
      <article class="prose prose-slate dark:prose-invert prose-lg max-w-none
        prose-headings:font-bold prose-headings:tracking-tight
        prose-a:text-brand-600 dark:prose-a:text-brand-400
        prose-code:text-brand-700 dark:prose-code:text-brand-300
        prose-img:rounded-xl prose-img:shadow-md">
        <Fragment set:html={contentHtml} />
      </article>

      <!-- Divider -->
      <div class="divider my-10"></div>

      <!-- Like Button Section -->
      <div class="flex items-center gap-4 my-8">
        {user ? (
          <button
            id="like-btn"
            data-post-id={post.id}
            data-liked={String(userLiked)}
            class:list={[
              'flex items-center gap-2 px-5 py-2.5 rounded-xl font-medium text-sm border transition-all duration-150 active:scale-95',
              userLiked
                ? 'bg-red-50 dark:bg-red-900/20 border-red-200 dark:border-red-800 text-red-600 dark:text-red-400'
                : 'bg-white dark:bg-slate-900 border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-400 hover:border-red-300 dark:hover:border-red-700 hover:text-red-500 dark:hover:text-red-400'
            ]}
            aria-label="Like this post"
          >
            <svg id="like-icon" width="18" height="18" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"
              fill={userLiked ? 'currentColor' : 'none'} class="transition-all">
              <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
            </svg>
            <span id="like-count">{likesCount ?? 0}</span>
            <span>{userLiked ? 'Liked' : 'Like'}</span>
          </button>
        ) : (
          <a href="/login" class="flex items-center gap-2 px-5 py-2.5 rounded-xl font-medium text-sm border border-slate-200 dark:border-slate-700 text-slate-500 dark:text-slate-400 hover:border-brand-300 hover:text-brand-600 transition-all">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
            </svg>
            <span>{likesCount ?? 0}</span>
            <span>Sign in to like</span>
          </a>
        )}
      </div>

      <!-- Divider -->
      <div class="divider my-10"></div>

      <!-- Comments Section -->
      <section aria-labelledby="comments-heading">
        <div class="flex items-center gap-3 mb-6">
          <h2 id="comments-heading" class="text-xl font-bold text-slate-900 dark:text-slate-100">
            Comments
          </h2>
          <span class="badge-blue">{comments.length}</span>
        </div>

        <!-- Comment form (authenticated only) -->
        {user ? (
          <form id="comment-form" class="mb-8 card p-4 space-y-3" data-post-id={post.id}>
            <label for="comment-input" class="label">Add a comment</label>
            <textarea
              id="comment-input"
              name="content"
              rows="3"
              class="input resize-none"
              placeholder="Share your thoughts..."
              required
              maxlength="2000"
            ></textarea>
            <div class="flex items-center justify-between">
              <span class="text-xs text-slate-400" id="char-count">0 / 2000</span>
              <button type="submit" id="comment-submit" class="btn-primary text-sm">
                Post Comment
              </button>
            </div>
          </form>
        ) : (
          <div class="mb-8 card p-6 text-center">
            <p class="text-slate-600 dark:text-slate-400 mb-3">Sign in to join the conversation</p>
            <a href="/login" class="btn-primary text-sm inline-flex">Sign In</a>
          </div>
        )}

        <!-- Comments list -->
        <div id="comments-list" class="space-y-4">
          {comments.length === 0 ? (
            <div class="text-center py-8 text-slate-400 dark:text-slate-600 text-sm">
              No comments yet. Be the first!
            </div>
          ) : (
            comments.map((comment) => (
              <div class="card p-4 animate-slide-up" id={`comment-${comment.id}`}>
                <div class="flex items-start gap-3">
                  <div class="w-8 h-8 rounded-full bg-gradient-to-br from-slate-400 to-slate-600 flex items-center justify-center text-xs font-bold text-white flex-shrink-0">
                    {comment.author_email[0].toUpperCase()}
                  </div>
                  <div class="flex-1 min-w-0">
                    <div class="flex items-center gap-2 mb-1">
                      <span class="text-sm font-medium text-slate-900 dark:text-slate-100 truncate">
                        {comment.author_email}
                      </span>
                      <span class="text-xs text-slate-400 dark:text-slate-500 flex-shrink-0">
                        {formatDate(comment.created_at)}
                      </span>
                    </div>
                    <p class="text-sm text-slate-700 dark:text-slate-300 leading-relaxed whitespace-pre-wrap break-words">
                      {comment.content}
                    </p>
                  </div>
                </div>
              </div>
            ))
          )}
        </div>
      </section>
    </div>
  </main>

  <!-- Footer -->
  <footer class="border-t border-slate-200 dark:border-slate-800 mt-12">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-sm text-slate-500 dark:text-slate-500">
      <p>© {new Date().getFullYear()} blog.solodev.co.in</p>
      <a href="/" class="hover:text-brand-600 dark:hover:text-brand-400 transition-colors">← Back to all articles</a>
    </div>
  </footer>
</Layout>

<script>
  // ── Like button ─────────────────────────────────────────────────────────────
  const likeBtn = document.getElementById('like-btn') as HTMLButtonElement | null;
  if (likeBtn) {
    likeBtn.addEventListener('click', async () => {
      const postId = likeBtn.dataset.postId!;
      const currentlyLiked = likeBtn.dataset.liked === 'true';

      likeBtn.disabled = true;

      try {
        const res = await fetch('/api/likes', {
          method: currentlyLiked ? 'DELETE' : 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ post_id: postId }),
        });
        const json = await res.json();

        if (res.ok) {
          const newLiked = !currentlyLiked;
          likeBtn.dataset.liked = String(newLiked);

          const countEl = document.getElementById('like-count')!;
          const headerCountEl = document.getElementById('header-likes');
          const icon = document.getElementById('like-icon')!;
          const labelSpan = likeBtn.querySelector('span:last-child')!;

          const newCount = parseInt(countEl.textContent ?? '0') + (newLiked ? 1 : -1);
          countEl.textContent = String(newCount);
          if (headerCountEl) headerCountEl.textContent = String(newCount);

          icon.setAttribute('fill', newLiked ? 'currentColor' : 'none');
          labelSpan.textContent = newLiked ? 'Liked' : 'Like';

          likeBtn.classList.toggle('bg-red-50', newLiked);
          likeBtn.classList.toggle('dark:bg-red-900/20', newLiked);
          likeBtn.classList.toggle('border-red-200', newLiked);
          likeBtn.classList.toggle('text-red-600', newLiked);
        } else {
          console.error('Like error:', json.error);
        }
      } catch (e) {
        console.error('Network error:', e);
      } finally {
        likeBtn.disabled = false;
      }
    });
  }

  // ── Comment form ─────────────────────────────────────────────────────────────
  const commentForm = document.getElementById('comment-form') as HTMLFormElement | null;
  const textarea = document.getElementById('comment-input') as HTMLTextAreaElement | null;
  const charCount = document.getElementById('char-count');
  const submitBtn = document.getElementById('comment-submit') as HTMLButtonElement | null;

  textarea?.addEventListener('input', () => {
    if (charCount) charCount.textContent = `${textarea.value.length} / 2000`;
  });

  commentForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const content = textarea?.value.trim();
    if (!content) return;

    const postId = commentForm.dataset.postId!;
    if (submitBtn) { submitBtn.disabled = true; submitBtn.textContent = 'Posting…'; }

    try {
      const res = await fetch('/api/comments', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ post_id: postId, content }),
      });
      const json = await res.json();

      if (res.ok && json.comment) {
        const list = document.getElementById('comments-list')!;
        const empty = list.querySelector('.text-center');
        if (empty) empty.remove();

        const div = document.createElement('div');
        div.className = 'card p-4 animate-slide-up';
        div.id = `comment-${json.comment.id}`;
        div.innerHTML = `
          <div class="flex items-start gap-3">
            <div class="w-8 h-8 rounded-full bg-gradient-to-br from-brand-400 to-sky-500 flex items-center justify-center text-xs font-bold text-white flex-shrink-0">
              ${json.comment.author_email?.[0]?.toUpperCase() ?? 'Y'}
            </div>
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-2 mb-1">
                <span class="text-sm font-medium text-slate-900 dark:text-slate-100">${json.comment.author_email ?? 'You'}</span>
                <span class="text-xs text-slate-400">just now</span>
              </div>
              <p class="text-sm text-slate-700 dark:text-slate-300 leading-relaxed whitespace-pre-wrap break-words">${json.comment.content}</p>
            </div>
          </div>
        `;
        list.appendChild(div);

        textarea!.value = '';
        if (charCount) charCount.textContent = '0 / 2000';
      } else {
        alert(json.error ?? 'Failed to post comment. Please try again.');
      }
    } catch (err) {
      console.error('Comment error:', err);
      alert('Network error. Please try again.');
    } finally {
      if (submitBtn) { submitBtn.disabled = false; submitBtn.textContent = 'Post Comment'; }
    }
  });
</script>
