---
// src/pages/posts/[slug].astro — Upgraded article reader with hero image + reading time
import { getCollection, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { Content } = await post.render();

const formattedDate = post.data.pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

// Reading time estimate (avg 200 wpm)
const wordCount = post.body.split(/\s+/).filter(Boolean).length;
const readingTime = Math.max(1, Math.ceil(wordCount / 200));
---

<Layout
  title={`${post.data.title} — SoloDev`}
  description={post.data.description}
  pubDate={post.data.pubDate}
>
  <!-- Hero image strip -->
  <div class="w-full h-72 sm:h-80 md:h-96 relative overflow-hidden bg-neutral-100 dark:bg-neutral-900">
    <img
      src={post.data.image}
      alt={post.data.title}
      class="w-full h-full object-cover"
      loading="eager"
      decoding="async"
    />
    <!-- Gradient overlay -->
    <div class="absolute inset-0 bg-gradient-to-t from-white dark:from-neutral-950 via-white/20 dark:via-neutral-950/20 to-transparent"></div>
  </div>

  <!-- Article content -->
  <div class="max-w-3xl mx-auto px-6 py-12">

    <!-- Back navigation -->
    <nav class="mb-10" aria-label="Breadcrumb">
      <a
        href="/"
        class="inline-flex items-center gap-1.5 text-sm text-neutral-500 dark:text-neutral-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors duration-150 no-underline group"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="group-hover:-translate-x-0.5 transition-transform duration-150"
          aria-hidden="true"
        >
          <path d="M19 12H5M12 5l-7 7 7 7"></path>
        </svg>
        All articles
      </a>
    </nav>

    <!-- Article header -->
    <header class="mb-10">
      <!-- Tags -->
      {post.data.tags && post.data.tags.length > 0 && (
        <div class="flex flex-wrap gap-2 mb-5">
          {post.data.tags.map(tag => (
            <span class="text-xs font-semibold text-indigo-600 dark:text-indigo-400 bg-indigo-50 dark:bg-indigo-950/50 px-2.5 py-1 rounded-full capitalize">
              #{tag}
            </span>
          ))}
        </div>
      )}

      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-neutral-900 dark:text-neutral-100 leading-tight mb-5">
        {post.data.title}
      </h1>

      {post.data.description && (
        <p class="text-lg sm:text-xl text-neutral-500 dark:text-neutral-400 leading-relaxed mb-6">
          {post.data.description}
        </p>
      )}

      <!-- Meta row -->
      <div class="flex flex-wrap items-center gap-3">
        <div class="flex items-center gap-2">
          <!-- Avatar -->
          <div class="w-8 h-8 rounded-full bg-gradient-to-br from-indigo-500 to-violet-600 flex items-center justify-center">
            <span class="text-white font-bold text-xs">S</span>
          </div>
          <span class="text-sm font-medium text-neutral-700 dark:text-neutral-300">SoloDev</span>
        </div>
        <span class="text-neutral-300 dark:text-neutral-700">·</span>
        <time
          datetime={post.data.pubDate.toISOString()}
          class="text-sm text-neutral-500 dark:text-neutral-400 tabular-nums"
        >
          {formattedDate}
        </time>
        <span class="text-neutral-300 dark:text-neutral-700">·</span>
        <span class="text-sm text-neutral-500 dark:text-neutral-400 flex items-center gap-1">
          <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
          {readingTime} min read
        </span>
      </div>

      <!-- Divider -->
      <div class="mt-8 h-px bg-gradient-to-r from-indigo-200 via-neutral-200 to-transparent dark:from-indigo-900/50 dark:via-neutral-800 dark:to-transparent"></div>
    </header>

    <!-- Article body -->
    <article
      class="prose prose-neutral dark:prose-invert max-w-none
             prose-headings:font-bold prose-headings:tracking-tight
             prose-h1:text-3xl prose-h2:text-2xl prose-h3:text-xl
             prose-h2:mt-12 prose-h2:mb-4
             prose-h3:mt-8 prose-h3:mb-3
             prose-a:text-indigo-600 dark:prose-a:text-indigo-400 prose-a:no-underline hover:prose-a:underline prose-a:font-medium
             prose-code:font-mono prose-code:text-sm prose-code:bg-neutral-100 dark:prose-code:bg-neutral-800 prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded-md prose-code:before:content-none prose-code:after:content-none prose-code:text-indigo-700 dark:prose-code:text-indigo-300
             prose-pre:bg-neutral-950 dark:prose-pre:bg-neutral-900 prose-pre:border prose-pre:border-neutral-800 prose-pre:rounded-xl prose-pre:text-sm prose-pre:shadow-lg
             prose-img:rounded-xl prose-img:max-w-full prose-img:shadow-md
             prose-blockquote:border-l-[3px] prose-blockquote:border-indigo-400 dark:prose-blockquote:border-indigo-600 prose-blockquote:text-neutral-600 dark:prose-blockquote:text-neutral-400 prose-blockquote:not-italic prose-blockquote:bg-neutral-50 dark:prose-blockquote:bg-neutral-900/50 prose-blockquote:px-5 prose-blockquote:py-1 prose-blockquote:rounded-r-lg
             prose-hr:border-neutral-200 dark:prose-hr:border-neutral-800
             prose-table:text-sm prose-th:font-semibold prose-th:text-neutral-900 dark:prose-th:text-neutral-100
             prose-thead:border-neutral-300 dark:prose-thead:border-neutral-700
             prose-strong:text-neutral-900 dark:prose-strong:text-neutral-100 prose-strong:font-semibold
             prose-li:marker:text-indigo-400"
    >
      <Content />
    </article>

    <!-- Footer navigation -->
    <footer class="mt-16 pt-8 border-t border-neutral-200 dark:border-neutral-800">
      <a
        href="/"
        class="inline-flex items-center gap-2 text-sm font-medium text-neutral-500 dark:text-neutral-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors duration-150 no-underline group"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="group-hover:-translate-x-0.5 transition-transform duration-150"
          aria-hidden="true"
        >
          <path d="M19 12H5M12 5l-7 7 7 7"></path>
        </svg>
        Back to all articles
      </a>
    </footer>
  </div>
</Layout>
