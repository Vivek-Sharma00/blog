---
// src/pages/index.astro — Modern card grid homepage
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const allPosts = await getCollection('blog');

// Sort newest-first
const posts = allPosts.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

function formatDate(date: Date): string {
  return date.toLocaleDateString('en-US', {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
  });
}
---

<Layout title="SoloDev — Writing on indie engineering, tools, and shipping in public">
  <div class="max-w-[1600px] mx-auto px-6 py-12">

    <!-- ── Hero Header ── -->
    <header class="mb-14 max-w-3xl">
      <div class="inline-flex items-center gap-2 mb-5">
        <span class="h-px w-8 bg-indigo-500"></span>
        <span class="text-xs font-semibold tracking-widest uppercase text-indigo-500 dark:text-indigo-400">
          SoloDev Blog
        </span>
      </div>
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-neutral-900 dark:text-neutral-100 leading-[1.08] mb-5">
        Ideas worth<br/>
        <span class="relative inline-block">
          <span class="relative z-10 bg-gradient-to-r from-indigo-500 via-violet-500 to-purple-500 bg-clip-text text-transparent">
            shipping.
          </span>
        </span>
      </h1>
      <p class="text-lg text-neutral-500 dark:text-neutral-400 leading-relaxed max-w-xl mb-6">
        Writing about indie engineering, developer tools, and the craft of building
        software alone — from zero to deployed.
      </p>
      <div class="flex items-center gap-3">
        <span class="inline-flex items-center gap-1.5 text-sm font-medium text-neutral-500 dark:text-neutral-400">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline></svg>
          {posts.length} articles
        </span>
        <span class="text-neutral-300 dark:text-neutral-700">·</span>
        <span class="inline-flex items-center gap-1.5 text-sm font-medium text-neutral-500 dark:text-neutral-400">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
          Updated {formatDate(posts[0].data.pubDate)}
        </span>
      </div>
    </header>

    <!-- ── Card Grid ── -->
    {posts.length === 0 ? (
      <p class="text-neutral-400 dark:text-neutral-600 text-center py-20">
        No posts yet. Check back soon.
      </p>
    ) : (
      <section aria-label="Blog posts">
        <ul class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-6 list-none p-0 m-0">
          {posts.map((post, i) => {
            const date = formatDate(post.data.pubDate);
            const firstTag = post.data.tags?.[0];
            return (
              <li class="group">
                <a
                  href={`/posts/${post.slug}`}
                  class="flex flex-col h-full no-underline rounded-2xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900 overflow-hidden hover:shadow-xl hover:shadow-neutral-200/60 dark:hover:shadow-neutral-900/60 hover:-translate-y-1.5 transition-all duration-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500"
                  aria-label={`Read: ${post.data.title}`}
                >
                  <!-- 1:1 Aspect Ratio Image -->
                  <div class="aspect-square overflow-hidden relative rounded-t-2xl bg-neutral-100 dark:bg-neutral-800">
                    <img
                      src={post.data.image}
                      alt={post.data.title}
                      class="object-cover w-full h-full group-hover:scale-105 transition-transform duration-500"
                      loading={i < 5 ? 'eager' : 'lazy'}
                      decoding="async"
                    />
                    <!-- Overlay gradient -->
                    <div class="absolute inset-0 bg-gradient-to-t from-black/30 via-transparent to-transparent"></div>
                    <!-- Tag / date badge -->
                    <div class="absolute bottom-3 left-3 flex items-center gap-2">
                      {firstTag && (
                        <span class="backdrop-blur-md bg-black/40 text-white text-xs font-semibold px-2.5 py-1 rounded-full capitalize tracking-wide">
                          {firstTag}
                        </span>
                      )}
                    </div>
                    <!-- Date badge top-right -->
                    <div class="absolute top-3 right-3">
                      <time
                        datetime={post.data.pubDate.toISOString()}
                        class="backdrop-blur-md bg-black/40 text-white text-xs px-2.5 py-1 rounded-full tabular-nums"
                      >
                        {date}
                      </time>
                    </div>
                  </div>

                  <!-- Card Body -->
                  <div class="p-5 flex flex-col justify-between flex-1">
                    <div>
                      <h2 class="font-bold text-base leading-snug line-clamp-2 text-neutral-900 dark:text-neutral-100 group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors duration-200 mb-2">
                        {post.data.title}
                      </h2>
                      <p class="text-sm text-neutral-500 dark:text-neutral-400 line-clamp-2 leading-relaxed">
                        {post.data.description}
                      </p>
                    </div>
                    <!-- Footer -->
                    <div class="mt-4 flex items-center justify-between">
                      <div class="flex flex-wrap gap-1.5">
                        {(post.data.tags ?? []).slice(0, 2).map(tag => (
                          <span class="text-xs text-indigo-600 dark:text-indigo-400 bg-indigo-50 dark:bg-indigo-950/50 px-2 py-0.5 rounded-full font-medium">
                            #{tag}
                          </span>
                        ))}
                      </div>
                      <span class="text-xs text-neutral-400 dark:text-neutral-500 font-medium group-hover:text-indigo-500 dark:group-hover:text-indigo-400 transition-colors duration-200 whitespace-nowrap ml-2">
                        Read →
                      </span>
                    </div>
                  </div>
                </a>
              </li>
            );
          })}
        </ul>
      </section>
    )}
  </div>
</Layout>
